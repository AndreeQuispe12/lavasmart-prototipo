# Copia este archivo a .streamlit/secrets.toml y cambia las claves.
# secrets.toml está en .gitignore: NUNCA lo subas al repositorio.
# En Streamlit Community Cloud pega este contenido en Settings > Secrets.
#
# rol: "operador" o "dueno" (sin ñ)
# nombre: el que se muestra en la barra lateral (opcional; si falta se usa el usuario)

# Pon true para mostrar en el login el recuadro con las cuentas de demostración.
# Para ocultarlo: false (o bórralo) y reinicia la app. Borra también las cuentas *_demo.
DEMO_MODE = true

[usuarios.operador]
clave = "cambia-esta-clave-operador"
rol = "operador"
nombre = "Nombre del operador"

[usuarios.dueno]
clave = "cambia-esta-clave-dueno"
rol = "dueno"
nombre = "Nombre del dueño"

# Cuentas de demostración (datos simulados). Distintas de las cuentas normales.
[usuarios.dueno_demo]
clave = "demo2026"
rol = "dueno"
nombre = "Dueño (demo)"

[usuarios.operador_demo]
clave = "demo2026"
rol = "operador"
nombre = "Operador (demo)"
