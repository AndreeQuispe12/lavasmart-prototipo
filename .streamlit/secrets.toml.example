# Copia este archivo a .streamlit/secrets.toml y completa las claves.
# secrets.toml está en .gitignore: NUNCA lo subas al repositorio.
# rol: "operador" o "dueno"
# nombre: el que se muestra en la barra lateral (opcional; si falta se usa el usuario)

[usuarios.operador]
clave = "121212"
rol = "operador"
nombre = "Nombre del operador"

[usuarios.dueno]
clave = "121212"
rol = "dueño"
